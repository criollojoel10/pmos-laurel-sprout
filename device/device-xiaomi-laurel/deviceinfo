# deviceinfo preliminar para Xiaomi Mi A3 (laurel_sprout)
#
# Basado en: port archivado de pmaports (device/testing/device-xiaomi-laurel),
# metadata real del dispositivo (device-metadata/fastboot-sanitized.json),
# análisis de ROMs de referencia (reports/android-reference-comparison.md) y
# análisis del port histórico (reports/postmarketos-history-analysis.md).

deviceinfo_format_version="0"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_name="Mi A3"
deviceinfo_codename="xiaomi-laurel"
deviceinfo_year="2019"

deviceinfo_arch="aarch64"
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"

# SoC / plataforma
deviceinfo_soc="Qualcomm SM6125 (trinket)"
deviceinfo_cpu="ARM Cortex-A75 (2) + A55 (6)"

# Flash / boot (A/B)
deviceinfo_flash_method="fastboot"
deviceinfo_has_boot_b_partition="true"
deviceinfo_has_system_b_partition="false"
deviceinfo_bootimg_recovery_support="true"

# Tamaños reales obtenidos del dispositivo (2026-08-02, slot a):
#   boot:   0x4000000 (64 MiB)
#   dtbo:   0x1800000 (24 MiB)   [no se modifica]
#   vbmeta: 0x10000  (64 KiB)    [no se modifica]
deviceinfo_boot_partition_start="0"
deviceinfo_boot_partition_size="0x4000000"

# DTB y boot.img — parámetros verificados contra boot.img stock V12.0.26.0
# (header v2, page 4096, base 0x0, offsets kernel/ramdisk/tags/dtb) y contra
# el deviceinfo histórico de pmaports (reports/postmarketos-history-analysis.md).
deviceinfo_dtb="qcom/sm6125-xiaomi-laurel-sprout"
deviceinfo_kernel="qcom-sm6125"
deviceinfo_kernel_cmdline="clk_ignore_unused console=ttyMSM0,115200n8"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_qcdt="false"
deviceinfo_bootimg_dtb_second="false"
deviceinfo_append_dtb="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_sparse="true"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_bootimg_boot_header_version="2"
deviceinfo_bootimg_dtb_offset="0x1f00000"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"

# Display (panel simple-framebuffer; DRM en desarrollo)
deviceinfo_screen_width="720"
deviceinfo_screen_height="1560"
deviceinfo_display_panel_type="samsung,s6e8fc0-m1906f9"
deviceinfo_framebuffer_address="0x5c000000"
deviceinfo_framebuffer_format="a8r8g8b8"

# Touchscreen
deviceinfo_touchscreen="focaltech,fts3518"
