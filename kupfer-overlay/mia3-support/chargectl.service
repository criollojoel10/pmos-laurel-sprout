[Unit]
Description=Hold battery around 50% (pmi632_chg)
# Wants+After (not just After): pull mia3-qg in so pmi632_chg finds the PMIC ready.
Wants=mia3-qg.service
After=mia3-qg.service

[Service]
ExecStartPre=/usr/bin/modprobe pmi632_chg
ExecStart=/usr/bin/python3 /usr/local/lib/chargectl/chargectl.py
# Hand charging back to the hardware on stop: nothing watches the battery while the service is down.
ExecStopPost=/bin/sh -c 'P=/sys/module/pmi632_chg/parameters; echo 0 > $P/usb_suspend; echo 1 > $P/charging_enabled; [ "$SERVICE_RESULT" = success ] || rm -f /run/chargectl.mode /run/chargectl.target /run/chargectl.usb /run/chargectl.hot /run/chargectl.thermal_resume'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
