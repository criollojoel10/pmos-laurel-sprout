#!/bin/busybox sh
# Licencia: GPL-3.0-or-later
# PID 1 nativo v2 para kernel v7.1. Sin módulos/scripts 6.1. No monta rootfs.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
APPLETS="$(/bin/busybox --list 2>/dev/null | tr '\n' ' ')"
have() { case " $APPLETS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# MAC locales de laboratorio derivadas (locally administered, no identidad de
# unidad ni del dispositivo). Se ensamblan en runtime para no publicar la forma
# completa de una dirección.
mac_gen() {
  id="$1"
  case "$id" in 1|2) ;; *) id=1 ;; esac
  printf '%s:%s:%s:%s:%s:%s' 02 71 00 00 00 "$id"
}

emit() {
  line="$*"
  echo "$line"
  for console in /dev/console /dev/tty0 /dev/ttyMSM0 /dev/kmsg; do
    test -e "$console" && echo "$line" > "$console" 2>/dev/null || true
  done
}

mark() {
  stage "$1"
  emit "$1"
  sync 2>/dev/null || true
}
stage() { printf '%s\n' "$1" > /run/v71-stage 2>/dev/null || true; }
pause2() { sleep 2; emit "$1 (repeat)"; sync 2>/dev/null || true; }

# Primera instrucción ejecutable: no depende de /proc, /sys, awk ni sed.
mark "V71_V2_PID1_FIRST_INSTRUCTION"
sleep 5
emit "V71_V2_PID1_FIRST_INSTRUCTION (after 5s)"

/bin/busybox mkdir -p /proc /sys /dev /run /tmp /mnt /sys/kernel/config /sys/kernel/debug

if /bin/busybox mount -t proc none /proc 2>&1; then mark V71_V2_PROC_READY; else mark V71_V2_PROC_FAILED; fi
pause2 V71_V2_PROC_READY
if /bin/busybox mount -t sysfs none /sys 2>&1; then mark V71_V2_SYS_READY; else mark V71_V2_SYS_FAILED; fi
pause2 V71_V2_SYS_READY
if /bin/busybox mount -t devtmpfs none /dev 2>&1; then mark V71_V2_DEVTMPFS_READY; else mark V71_V2_DEVTMPFS_FAILED; fi
pause2 V71_V2_DEVTMPFS_READY
/bin/busybox mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mark V71_V2_SYSTEM_MOUNTS_DONE

for param in /sys/module/kernel/parameters/consoleblank /sys/module/vt/parameters/consoleblank; do
  test -w "$param" && printf '0' > "$param" 2>/dev/null || true
done
printf '\033[9;0' > /dev/console 2>/dev/null || true
mark V71_V2_ANTIBLANK_SET

# --- Estado del framebuffer ---
mark V71_V2_FB_STATUS_BEGIN
ls -la /dev/fb* 2>/dev/null || echo "  sin /dev/fbX"
cat /sys/class/graphics/fb0/name 2>/dev/null || echo "  fb0/name ausente"
cat /sys/class/graphics/fb0/modes 2>/dev/null || true
cat /sys/class/graphics/fb0/stride 2>/dev/null || true
mark V71_V2_FB_STATUS_END
pause2 V71_V2_FB_STATUS_END
if test -e /dev/fb0; then emit V71_V2_FB_PRESENT; else emit V71_V2_FB_ABSENT; fi
if ls /dev/sd* /dev/mmcblk* >/dev/null 2>&1; then emit V71_V2_UFS_PRESENT; else emit V71_V2_UFS_ABSENT; fi

# --- Auditoría USB antes de configfs ---
mark V71_V2_USB_PHY_STATUS_BEGIN
ls -la /sys/bus/platform/devices 2>/dev/null | grep -iE 'usb|dwc|qusb|phy' || echo "  sin devices usb/dwc/qusb/phy"
ls -la /sys/bus/platform/drivers/dwc3 2>/dev/null || echo "  sin driver dwc3"
ls -la /sys/bus/platform/drivers/dwc3-qcom 2>/dev/null || echo "  sin driver dwc3-qcom"
cat /proc/device-tree/soc@0/usb*/status 2>/dev/null || echo "  dt usb status n/d"
cat /proc/device-tree/soc@0/usb*/dwc3*/status 2>/dev/null || echo "  dt dwc3 status n/d"
cat /sys/kernel/debug/devices_deferred 2>/dev/null || echo "  sin devices_deferred"
mark V71_V2_USB_PHY_STATUS_END
pause2 V71_V2_USB_PHY_STATUS_END

mark V71_V2_DWC3_STATUS_BEGIN
dmesg 2>/dev/null | grep -iE 'dwc3|qusb2|usb.*phy|gadget|udc' || echo "  sin mensajes dwc3/usb en dmesg"
cat /sys/kernel/debug/clk/clk_summary 2>/dev/null | grep -iE 'usb|dwc|qusb|phy' || echo "  sin clocks usb en clk_summary"
cat /sys/kernel/debug/regulator/regulator_summary 2>/dev/null | grep -iE 'usb|qusb|phy' || echo "  sin regulators usb"
mark V71_V2_DWC3_STATUS_END
pause2 V71_V2_DWC3_STATUS_END

mark V71_V2_UDC_SCAN_BEGIN
ls -la /sys/class/udc 2>/dev/null || echo "  sin /sys/class/udc"
find /sys/class/udc -maxdepth 2 -type f 2>/dev/null || true
mark V71_V2_UDC_SCAN_END
pause2 V71_V2_UDC_SCAN_END

# --- Gadget escalonado ---
udc_name=""
mark "V71_V2_UDC_WAIT segundo=0"
i=0
while [ "$i" -lt 30 ]; do
  for udc in /sys/class/udc/*; do
    if test -e "$udc"; then
      udc_name="${udc##*/}"
      mark "V71_V2_UDC_FOUND name=$udc_name"
      break 2
    fi
  done
  i=$((i + 1))
  [ "$i" -lt 30 ] && mark "V71_V2_UDC_WAIT segundo=$i"
  sleep 1
done
if [ -z "$udc_name" ]; then
  emit V71_V2_UDC_TIMEOUT
  emit "V71_V2_GADGET_BIND_FAILED no-udc"
else
  function="$(/bin/busybox cat /etc/diag-usb-function 2>/dev/null || echo rndis)"
  G=/sys/kernel/config/usb_gadget/v71diag
  mark V71_V2_CONFIGFS_BEGIN
  /bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null || true
  /bin/busybox mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" \
    "$G/functions/$function.usb0" 2>/dev/null || true
  rc=$?
  emit "V71_V2_CONFIGFS_MKDIR rc=$rc"
  printf '0x18d1' > "$G/idVendor" 2>/dev/null || true
  printf '0x4ee7' > "$G/idProduct" 2>/dev/null || true
  printf 'v71diag' > "$G/strings/0x409/serialnumber" 2>/dev/null || true
  printf 'postmarketOS' > "$G/strings/0x409/manufacturer" 2>/dev/null || true
  printf 'laurel v7.1 diag v2' > "$G/strings/0x409/product" 2>/dev/null || true
  printf 'USB %s diagnostic' "$function" > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
  # MAC locales de laboratorio (locally administered, no identidad de unidad).
  printf '%s' "$(mac_gen 1)" > "$G/functions/$function.usb0/dev_addr" 2>/dev/null || true
  printf '%s' "$(mac_gen 2)" > "$G/functions/$function.usb0/host_addr" 2>/dev/null || true
  mark V71_V2_CONFIGFS_END
  pause2 V71_V2_CONFIGFS_END
  mark V71_V2_GADGET_BIND_BEGIN
  /bin/busybox ln -sfn "$G/functions/$function.usb0" "$G/configs/c.1/$function.usb0" 2>/dev/null
  rc=$?
  emit "V71_V2_GADGET_SYMLINK rc=$rc"
  printf '%s' "$udc_name" > "$G/UDC" 2>/dev/null
  rc=$?
  emit "V71_V2_GADGET_BIND rc=$rc udc=$udc_name"
  if [ "$rc" -eq 0 ]; then
    mark V71_V2_GADGET_BIND_SUCCESS
  else
    emit V71_V2_GADGET_BIND_FAILED
  fi
  i=0
  found=""
  while [ "$i" -lt 20 ]; do
    for iface in /sys/class/net/usb0 /sys/class/net/rndis0 /sys/class/net/*; do
      case "$iface" in
        /sys/class/net/lo) continue ;;
        /sys/class/net/*) test -d "$iface" || continue; found="${iface##*/}"; break 2 ;;
      esac
    done
    sleep 1
    i=$((i + 1))
  done
  if [ -n "$found" ]; then
    emit "V71_V2_USB0_PRESENT iface=$found"
    if have ifconfig; then
      /bin/busybox ifconfig "$found" 172.16.42.1 netmask 255.255.255.0 up 2>&1
      emit "V71_V2_NET_CONFIGURED iface=$found ip=172.16.42.1"
      if have telnetd; then
        /bin/busybox telnetd -f /etc/issue -l /bin/sh -p 23 2>/dev/null
        emit V71_V2_TELNET_STARTED
      else
        emit V71_V2_TELNET_FAILED
      fi
    fi
  else
    emit V71_V2_USB0_ABSENT
    emit V71_V2_TELNET_FAILED
  fi
fi

emit "V71_V2_CMDLINE $(cat /proc/cmdline 2>/dev/null)"
emit V71_V2_DMESG_FILTERED_BEGIN
dmesg 2>/dev/null | grep -iE 'dwc3|qusb2|usb|phy|udc|gadget|configfs|deferred|regulator|clock|genpd|probe|error|fail' || true
emit V71_V2_DMESG_FILTERED_END

mark V71_V2_INITRAMFS_REACHED
mark V71_V2_STABLE_LOOP

# Heartbeat cada 10 s.
(
  while true; do
    uptime_value="$(awk '{print $1}' /proc/uptime 2>/dev/null || echo '?')"
    current_stage="$(cat /run/v71-stage 2>/dev/null || echo unknown)"
    emit "[V71_V2_HEARTBEAT] uptime=$uptime_value stage=$current_stage"
    sleep 10
  done
) &

if test -c /dev/console; then
  PS1='v71diag# '
  /bin/busybox sh </dev/console >/dev/console 2>&1 || true
fi
while true; do sleep 3600; done
