#!/bin/busybox sh
#
# Licencia: GPL-3.0-or-later
#
# init — initramfs mínimo de diagnóstico para Xiaomi Mi A3 (laurel_sprout)
# arrancado vía `fastboot boot boot.img` o flasheado en boot (RAM/rootfs NO
# se tocan; solo diagnóstico).
#
# Objetivo: confirmar que el kernel mainline (6.1 histórico y 7.1) arranca,
# que la consola serial (ttyMSM0) responde y poder recoger logs. NO monta el
# rootfs del dispositivo, NO formatea, NO flashea, NO reinicia, NO escribe
# particiones, NO cambia slot.
#
# Es PID 1: SIEMPRE debe sobrevivir. NINGÚN fallo de un comando diagnóstico
# puede hacer salir el init (sin `set -e`), y el final abre una shell de
# rescate y luego un bucle infinito para que el kernel jamás dispare
# 'Attempted to kill init!'.
#
# Historial de fallos:
#  - EX3 (2026-08-09): `/init: line 35: sed: not found` -> PID 1 salió ->
#    "Kernel panic - not syncing: Attempted to kill init! exitcode=0x00007f00".
#    Causa: el initramfs no instaló el applet sed. Este init ya no muere si
#    falta cualquier applet (usa /bin/busybox explícito y fallbacks).

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

log()  { echo "[diag-init] $*"; }
diag() { echo "[diag] $*"; }

# Lista de applets disponibles (para mensajes y fallbacks; nunca para abortar).
APPLETS="$(/bin/busybox --list 2>/dev/null | tr '\n' ' ')"

have() { # have <applet> -> 0 si está disponible
  case " $APPLETS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Indentación tolerante: si sed no está, simplemente no se indenta.
indent() {
  if have sed; then
    /bin/busybox sed 's/^/  /'
  else
    /bin/busybox cat
  fi
}

log "=== initramfs de diagnóstico laurel_sprout (mainline) ==="
log "kernel: $(/bin/busybox uname -r) [$(/bin/busybox uname -m)]"
if have awk; then
  # shellcheck disable=SC2016  # awk recibe {print $1} literal; el $1 lo expande awk
  log "uptime: $(/bin/busybox awk '{print $1}' /proc/uptime 2>/dev/null) s"
else
  log "uptime: (awk no disponible)"
fi

# 1) pseudo-filesystems de diagnóstico (fallos NO son fatales)
/bin/busybox mkdir -p /proc /sys /dev /run /tmp /mnt
/bin/busybox mount -t proc     none /proc 2>&1 || true
/bin/busybox mount -t sysfs    none /sys  2>&1 || true
/bin/busybox mount -t devtmpfs none /dev  2>&1 || true

log "--- mtab ---"
/bin/busybox mount 2>/dev/null | indent

# Diagnóstico temprano del framebuffer que entrega el bootloader.
diag "framebuffer sysfs:"
/bin/busybox cat /sys/class/graphics/fb0/name 2>/dev/null | indent || diag "  fb0/name ausente"
/bin/busybox cat /sys/class/graphics/fb0/modes 2>/dev/null | indent || true
/bin/busybox cat /sys/class/graphics/fb0/stride 2>/dev/null | indent || true
/bin/busybox cat /sys/class/graphics/fb0/virtual_size 2>/dev/null | indent || true
diag "nodo DT framebuffer:"
if test -e /sys/firmware/devicetree/base/chosen/framebuffer@5c000000; then
  diag "  /chosen/framebuffer@5c000000 presente"
else
  diag "  /chosen/framebuffer@5c000000 ausente"
fi

# Protección doble contra el blanking del VT: consoleblank=0 va en cmdline,
# pero algunos handoffs de framebuffer pueden conservar el valor por defecto.
for blank_param in /sys/module/kernel/parameters/consoleblank \
                   /sys/module/vt/parameters/consoleblank; do
  if test -w "$blank_param"; then
    printf '0' > "$blank_param" 2>/dev/null || true
    diag "consoleblank runtime: 0 ($blank_param)"
  fi
done
printf '\033[9;0' > /dev/console 2>/dev/null || true

# 2) Diagnóstico de hardware visible en mainline
diag "nodos de video (drm):"
/bin/busybox ls -l /dev/dri 2>/dev/null | indent || diag "  sin /dev/dri (DRM no hay /panel no probado)"
diag "framebuffer simple:"
/bin/busybox ls -l /dev/fb* 2>/dev/null | indent || diag "  sin /dev/fbX (simple-framebuffer no enlazado)"
diag "bloques UFS/emmc:"
/bin/busybox ls -l /dev/sd* /dev/mmcblk* 2>/dev/null | indent || diag "  sin blkdevs"
diag "ramoops/pstore:"
/bin/busybox ls -la /sys/fs/pstore 2>/dev/null | indent || diag "  /sys/fs/pstore sin montar"
/bin/busybox mount -t pstore pstore /sys/fs/pstore 2>/dev/null && diag "  pstore montado" || true

diag "UDC disponibles:"
/bin/busybox ls -l /sys/class/udc 2>/dev/null | indent || diag "  sin UDC"
diag "usb0:"
/bin/busybox ls -l /sys/class/net/usb0 2>/dev/null | indent || diag "  usb0 ausente"
if have ifconfig; then
  # RNDIS temporal por configfs; las MAC las genera el kernel y no se fijan en
  # el repositorio. El enlace es punto a punto con el host de prueba.
  /bin/busybox mkdir -p /sys/kernel/config
  /bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null || true
  G=/sys/kernel/config/usb_gadget/diag
  /bin/busybox mkdir -p "$G" "$G/strings/0x409" \
    "$G/configs/c.1/strings/0x409" "$G/functions/rndis.usb0" 2>/dev/null || true
  printf '0x18d1' > "$G/idVendor" 2>/dev/null || true
  printf '0x4ee7' > "$G/idProduct" 2>/dev/null || true
  printf 'laurel_sprout' > "$G/strings/0x409/serialnumber" 2>/dev/null || true
  printf 'pmos' > "$G/strings/0x409/manufacturer" 2>/dev/null || true
  printf '7.1 diagnostic' > "$G/strings/0x409/product" 2>/dev/null || true
  printf 'RNDIS diagnostic' > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
  /bin/busybox ln -s "$G/functions/rndis.usb0" "$G/configs/c.1/rndis.usb0" 2>/dev/null || true
  for udc in /sys/class/udc/*; do
    test -e "$udc" || continue
    printf '%s' "${udc##*/}" > "$G/UDC" 2>/dev/null || true
    break
  done
fi
if test -d /sys/class/net/usb0 && have ifconfig; then
  /bin/busybox ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>&1 || true
  diag "usb0 configurado para diagnóstico en 172.16.42.1/24"
  if have telnetd; then
    /bin/busybox telnetd -f /etc/issue -l /bin/sh -p 23 2>&1 || true
    diag "telnetd diagnóstico iniciado en usb0:23 (sin autenticación, enlace aislado)"
  else
    diag "telnetd no disponible en BusyBox"
  fi
fi

log "=== diagnostico de dispositivos (cpufreq /regulators) ==="
diag "gobernadores: $(/bin/busybox cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/d)"
if have wc && have tr; then
  diag "reguladores pm6125: $(/bin/busybox ls /sys/class/regulator 2>/dev/null | /bin/busybox wc -l | /bin/busybox tr -d ' ') vregs"
else
  diag "reguladores pm6125: (wc/tr no disponibles)"
fi

# 3) Firmware zap-shader (GPU) — solo info, no se carga aquí
diag "firmware: $(/bin/busybox ls /lib/firmware/qcom/sm6125/xiaomi/laurel 2>/dev/null || echo 'sin-fw (no necesario para este initramfs)')"

log "=== fin del init (a partir de aqui: consola + triggers) ==="
log "linea de comandos del kernel: $(/bin/busybox cat /proc/cmdline)"
diag "dmesg display/usb:"
/bin/busybox dmesg 2>/dev/null | /bin/busybox grep -iE 'simplefb|simpledrm|fbcon|framebuffer|msm|dpu|dsi|panel|dwc3|gadget|udc|rndis' | indent || true

# --- 4) Abrir una shell en la consola serial principal (ttyMSM0) ---
# Cuando el serial (UART a 115200) esta conectado, esto da interaccion.
# Si no hay terminal, se queda en esta consola (no panics).
if have setsid && test -c /dev/ttyMSM0; then
    for try in /dev/ttyMSM0 /dev/ttyS0 /dev/console; do
        if test -c "$try"; then
            log "lanzando shell en $try"
            /bin/busybox setsid sh -c "exec 3<$try; exec 4>$try; sh <&3 >&4 2>&4" &
            break
        fi
    done
fi

log "[diag-init] INITRAMFS_REACHED"
log "[diag-init] entering rescue shell"
# getty sobre la consola del kernel; si termina, se mantiene PID 1 vivo.
PS1='pmos-diag# ' sh </dev/console >/dev/console 2>&1
log "[diag-init] rescue shell salio; manteniendo PID 1 vivo"

# Nunca salir: el kernel paniquearia con 'Attempted to kill init!'.
while true; do
    sleep 3600
done
