#!/bin/busybox sh
# Licencia: GPL-3.0-or-later
# PID 1 DISPLAY-FIRST v4 para kernel v7.1. No monta rootfs.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
APPLETS="$(/bin/busybox --list 2>/dev/null | tr '\n' ' ')"
have() { case " $APPLETS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
stage() { printf '%s\n' "$1" > /run/v71-stage 2>/dev/null || true; }
emit() {
  line="$*"; echo "$line"
  for c in /dev/console /dev/tty0 /dev/ttyMSM0 /dev/kmsg; do
    test -e "$c" && echo "$line" > "$c" 2>/dev/null || true
  done
}
mark() { stage "$1"; emit "$1"; sleep 2; emit "$1 (repeat)"; sync 2>/dev/null || true; }
mac_gen() { id="$1"; case "$id" in 1|2) ;; *) id=1 ;; esac; printf '%s:%s:%s:%s:%s:%s' 02 74 00 00 00 "$id"; }

mark V71_V4_PID1_FIRST_INSTRUCTION
sleep 8; emit "V71_V4_PID1_FIRST_INSTRUCTION (after 8s)"
/bin/busybox mkdir -p /proc /sys /dev /run /tmp /mnt /sys/kernel/config /sys/kernel/debug

if mount -t proc none /proc 2>&1; then mark V71_V4_PROC_READY; else mark V71_V4_PROC_FAILED; fi
if mount -t sysfs none /sys 2>&1; then mark V71_V4_SYS_READY; else mark V71_V4_SYS_FAILED; fi
if mount -t devtmpfs none /dev 2>&1; then mark V71_V4_DEVTMPFS_READY; else mark V71_V4_DEVTMPFS_FAILED; fi
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true

for p in /sys/module/kernel/parameters/consoleblank /sys/module/vt/parameters/consoleblank; do
  test -w "$p" && printf '0' > "$p" 2>/dev/null || true
done
printf '\033[9;0' > /dev/console 2>/dev/null || true

(
  while true; do
    emit "[V71_V4_HEARTBEAT] uptime=$(awk '{print $1}' /proc/uptime 2>/dev/null || echo '?') stage=$(cat /run/v71-stage 2>/dev/null || echo unknown) fb=$(test -e /dev/fb0 && echo present || echo absent) udc=$(find /sys/class/udc -mindepth 1 -maxdepth 1 -print 2>/dev/null | head -1)"
    sleep 10
  done
) &

display_color() {
  color="$1"
  path="/usr/share/v71-display/${color}.raw"
  mark V71_V4_FB_DIRECT_WRITE_BEGIN
  if test -c /dev/fb0 && test -f "$path" && cat "$path" > /dev/fb0 2>/dev/null; then
    mark V71_V4_FB_DIRECT_WRITE_SUCCESS
    case "$color" in
      green) mark V71_V4_FB_CHECKPOINT_GREEN ;;
      blue) mark V71_V4_FB_CHECKPOINT_BLUE ;;
      red) mark V71_V4_FB_CHECKPOINT_RED ;;
    esac
  else
    mark V71_V4_FB_DIRECT_WRITE_FAILED
  fi
  sleep 8
  if test -e /dev/fb0; then emit V71_V4_FB_STILL_ALIVE; else emit V71_V4_FB_LOST; fi
}

if test -c /dev/fb0; then
  mark V71_V4_FB_DEVICE_PRESENT
  if test -e /sys/class/graphics/fbcon; then mark V71_V4_FBCON_PRESENT; else mark V71_V4_FBCON_ABSENT; fi
  cat /sys/class/graphics/fb0/name /sys/class/graphics/fb0/modes \
    /sys/class/graphics/fb0/stride /sys/class/graphics/fb0/virtual_size 2>/dev/null || true
  display_color green
else
  mark V71_V4_FB_DEVICE_ABSENT
  mark V71_V4_FBCON_ABSENT
fi

# Display summary: máximo unas pocas líneas, dmesg completo solo en tmpfs.
dmesg > /run/v71-v4-dmesg.log 2>/dev/null || true
emit "=== V71 V4 DISPLAY SUMMARY BEGIN ==="
grep -iE 'panic|oops|BUG:|Call trace|Unable to handle|SError|watchdog|simplefb|simpledrm|fb0|fbcon|framebuffer|console|blank' /run/v71-v4-dmesg.log 2>/dev/null | tail -30 || true
emit "=== V71 V4 DISPLAY SUMMARY END ==="
mark V71_V4_DISPLAY_AUDIT_COMPLETE
if test -c /dev/fb0; then display_color blue; fi

# USB después de iniciar heartbeat y checkpoints visuales.
mark V71_V4_USB_AUDIT_BEGIN
ls -la /sys/bus/platform/devices /sys/bus/platform/drivers/qcom-dwc3 \
  /sys/bus/platform/drivers/dwc3 /sys/bus/platform/drivers/qcom-qusb2-phy 2>/dev/null || true
cat /sys/kernel/debug/devices_deferred 2>/dev/null || true
dmesg | grep -iE 'dwc3|qusb2|usb|phy|udc|gadget|extcon|deferred|regulator|clock|genpd|probe|error|fail' | tail -30 || true

udc_name=""; n=0
while [ "$n" -lt 30 ]; do
  for udc in /sys/class/udc/*; do test -e "$udc" || continue; udc_name="${udc##*/}"; break 2; done
  emit "V71_V4_UDC_WAIT second=$n"; n=$((n + 1)); sleep 1
done
if [ -n "$udc_name" ]; then
  mark "V71_V4_UDC_FOUND name=$udc_name"
  G=/sys/kernel/config/usb_gadget/v71diag
  mount -t configfs none /sys/kernel/config 2>/dev/null || true
  mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/rndis.usb0" 2>/dev/null || true
  printf '0x18d1' > "$G/idVendor" 2>/dev/null || true
  printf '0x4ee7' > "$G/idProduct" 2>/dev/null || true
  printf 'v71v4' > "$G/strings/0x409/serialnumber" 2>/dev/null || true
  printf 'postmarketOS' > "$G/strings/0x409/manufacturer" 2>/dev/null || true
  printf 'laurel v7.1 display first' > "$G/strings/0x409/product" 2>/dev/null || true
  printf '%s' "$(mac_gen 1)" > "$G/functions/rndis.usb0/dev_addr" 2>/dev/null || true
  printf '%s' "$(mac_gen 2)" > "$G/functions/rndis.usb0/host_addr" 2>/dev/null || true
  mark V71_V4_GADGET_BIND_BEGIN
  ln -sfn "$G/functions/rndis.usb0" "$G/configs/c.1/rndis.usb0" 2>/dev/null || true
  if printf '%s' "$udc_name" > "$G/UDC" 2>/dev/null; then
    mark V71_V4_RNDIS_BOUND
    n=0; iface=""
    while [ "$n" -lt 20 ]; do
      for i in usb0 rndis0; do test -d "/sys/class/net/$i" && iface="$i" && break 2; done
      n=$((n + 1)); sleep 1
    done
    if [ -n "$iface" ]; then
      ifconfig "$iface" 172.16.42.1 netmask 255.255.255.0 up 2>&1 || true
      telnetd -f /etc/issue -l /bin/sh -p 23 2>/dev/null || true
    else
      mark V71_V4_RNDIS_BIND_FAILED
    fi
  else
    mark V71_V4_RNDIS_BIND_FAILED
  fi
else
  mark V71_V4_UDC_TIMEOUT
  if test -c /dev/fb0; then display_color red; fi
fi

mark V71_V4_STABLE_LOOP
while true; do sleep 3600; done
