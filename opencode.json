{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "*": "ask",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",

    "external_directory": {
      "*": "deny",
      "~/Projects/pmos-laurel-sprout/*": "allow"
    },

    "bash": {
      "*": "ask",

      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "free *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "wc *": "allow",
      "printf *": "allow",
      "echo *": "allow",
      "date *": "allow",
      "jq *": "allow",
      "sha256sum *": "allow",
      "shellcheck *": "allow",

      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "ask",
      "chmod *": "ask",

      "git init*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git branch*": "allow",
      "git switch *": "allow",
      "git checkout *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git remote *": "allow",
      "git fetch *": "allow",
      "git tag *": "allow",
      "git push": "allow",
      "git push origin *": "allow",

      "gh auth status*": "allow",
      "gh repo view*": "allow",
      "gh repo list*": "allow",
      "gh repo edit *": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh workflow run *": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh run download*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr create *": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue create *": "allow",
      "gh release view*": "allow",
      "gh api *": "allow",

      "fastboot devices": "allow",
      "fastboot getvar product": "allow",
      "fastboot getvar current-slot": "allow",
      "fastboot getvar unlocked": "allow",
      "fastboot getvar slot-count": "allow",
      "fastboot getvar has-slot:boot": "allow",
      "fastboot getvar has-slot:dtbo": "allow",
      "fastboot getvar has-slot:vbmeta": "allow",
      "fastboot getvar partition-size:boot_a": "allow",
      "fastboot getvar partition-size:boot_b": "allow",
      "fastboot getvar partition-size:dtbo_a": "allow",
      "fastboot getvar partition-size:dtbo_b": "allow",
      "fastboot getvar partition-size:vbmeta_a": "allow",
      "fastboot getvar partition-size:vbmeta_b": "allow",
      "fastboot getvar partition-type:boot_a": "allow",
      "fastboot getvar partition-type:boot_b": "allow",
      "fastboot getvar partition-type:dtbo_a": "allow",
      "fastboot getvar partition-type:dtbo_b": "allow",
      "fastboot getvar partition-type:vbmeta_a": "allow",
      "fastboot getvar partition-type:vbmeta_b": "allow",

      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",

      "gh repo delete *": "deny",
      "gh repo archive *": "deny",
      "gh release create *": "ask",
      "gh release delete *": "deny",
      "gh secret *": "deny",

      "git clone *": "deny",
      "make *": "deny",
      "ninja *": "deny",
      "pmbootstrap *": "deny",
      "podman *": "deny",
      "docker *": "deny",

      "adb *": "deny",

      "fastboot boot *": "deny",
      "fastboot flash *": "deny",
      "fastboot erase *": "deny",
      "fastboot format *": "deny",
      "fastboot set_active *": "deny",
      "fastboot reboot*": "deny",
      "fastboot continue*": "deny",
      "fastboot update*": "deny",
      "fastboot flashall*": "deny",
      "fastboot oem *": "deny",
      "fastboot flashing *": "deny",
      "fastboot -w*": "deny",

      "dd *": "deny",
      "sudo dd *": "deny",
      "mkfs*": "deny",
      "sudo mkfs*": "deny",
      "wipefs *": "deny",
      "sudo wipefs *": "deny",
      "parted *": "deny",
      "sudo parted *": "deny",
      "sgdisk *": "deny",
      "sudo sgdisk *": "deny",
      "fdisk *": "deny",
      "sudo fdisk *": "deny",

      "rm -rf *": "deny",
      "sudo rm -rf *": "deny",
      "sudo *": "deny",

      "* /dev/block/*": "deny",
      "* /dev/sd?*": "deny",
      "* /dev/nvme*": "deny",
      "* /dev/mmcblk*": "deny"
    }
  }
}
