# Base del kernel para SM6125 laurel_sprout (ARM64, systemd, postmarketOS)
# Fragmento base: se combina con la defconfig del árbol Linux mainline v7.1
# (base elegida en DECISION-0002). Solo se listan símbolos que deben existir;
# verify-kconfig.sh comprueba cada uno contra el Kconfig del commit fijado.

CONFIG_ARM64=y
CONFIG_LOCALVERSION="-postmarketos-sm6125"

# Filesystems de rootfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_STAT_FS=y

# UFS
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_QCOM=y

# PHYs Qualcomm (built-in: obligatorios para UFS y USB en el initramfs)
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y

# pstore/ramoops (built-in: evidencia tras crash/reboot en initramfs)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB / DWC3 / gadget
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGETFS=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y

# I2C / GENI
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y

# Touchscreen FT3518 (mainline: driver edt-ft5x06, compatible focaltech,ft3518)
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# DRM / MSM
# Bring-up de pantalla: el DTB ya declara /chosen/framebuffer@5c000000 y el
# kernel 6.1 probado lo expone mediante simplefb/fbcon. FB_SIMPLE enlaza
# directamente el nodo OF "simple-framebuffer"; SYSFB_SIMPLEFB no aplica en
# ARM64 (solo X86/EFI) y DRM_SIMPLEDRM no se habilita simultáneamente porque
# FB_SIMPLE depende de !DRM_SIMPLEDRM.
CONFIG_DRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=m
CONFIG_DRM_MSM_DSI=m
CONFIG_DRM_MSM_MDSS=m
CONFIG_DRM_PANEL_SAMSUNG_S6E8FC0=m

# Backlight: el panel queda como módulo para la fase DRM/GPU posterior.
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# fbcon (paridad con 6.1, que muestra consola en pantalla):
# DRM_FBDEV_EMULATION crea /dev/fb0 a partir del DRM; FRAMEBUFFER_CONSOLE
# dibuja la consola de texto sobre él. Con cmdline sin console=, o con
# console=tty0 al final, la consola/rescue shell sale en la pantalla.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y

# IOMMU / SMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DMA=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# Interconnect / regulator / pinctrl / GPIO
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
# GPIO_SYSFS depende de SYSFS+GPIO_CDEV; opcional en v7.1.
# CONFIG_GPIO_SYSFS=y
# NOTA: pinctrl-sm6125.c existe en v7.1 (drivers/pinctrl/qcom/Makefile) pero
# el Kconfig no define CONFIG_PINCTRL_SM6125 en este tag (prompt ausente);
# el driver no se puede habilitar hasta que el Kconfig suba upstream (v7.2+).
# CONFIG_PINCTRL_SM6125=y

# Dependencias de DRM_MSM: se mantienen built-in para que el módulo DRM pueda
# cargarse más adelante sin volver a degradar otras piezas del SoC.
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y

# Remoteproc / RPMSG / QRTR
CONFIG_REMOTEPROC=y
# v7.1: QCOM_Q6V5_ADSP/MSS tienen "depends on QCOM_SYSMON || QCOM_SYSMON=n".
# La defconfig base deja QCOM_SYSMON=m, lo que capa los PILs a =m; forzarlo a
# =y mantiene Q6V5_ADSP/MSS built-in tras `make olddefconfig`.
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y

# Firmware loader
CONFIG_FW_LOADER=y

# CPUfreq / CPUidle
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_IDLE=y
CONFIG_DT_IDLE_STATES=y

# Thermal
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Power supply (mainline v7.1 no trae QCOM_BATT_METER/QCOM_SPMI_SCHG de
# sm61x5-mainline; el PMI632 charger/battery quedará sin driver dedicado,
# igual que en otros ports mainline iniciales de SM6125)
CONFIG_POWER_SUPPLY=y

# WLAN / BT Qualcomm
# v7.1: BT depende de RFKILL ("depends on RFKILL || !RFKILL"); CFG80211 también
# depende de RFKILL, y ATH10K/WCN36XX dependen de MAC80211 (que depende de
# CFG80211). Con la base en =m, pedir =y en los drivers capa todo a =m; forzar
# la cadena RFKILL->CFG80211->MAC80211 a =y mantiene ATH10K/BT/WCN36XX built-in.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_WCN36XX=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_QCOMSMD=y

# WCN36XX y BT_QCOMSMD 'depends on QCOM_WCNSS_CTRL || QCOM_WCNSS_CTRL=n'.
# En aritmética tristate, si QCOM_WCNSS_CTRL queda =m la expresión se evalúa
# "m || n = m" y olddefconfig capa ambos a =m. Forzarlo a =y mantiene la
# cadena WCN36XX/BT_QCOMSMD built-in (igual que OCMEM/LLCC/SYSMON).
CONFIG_QCOM_WCNSS_CTRL=y

# GPU Adreno 610 (driver msm; el nodo DTS gpu@5900000 es parche downstream).
# DRM_MSM_GPU_SUDO (debug) requiere EXPERT; no se fuerza desde el fragmento.

# Proc
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
