# Base del kernel para SM6125 laurel_sprout (ARM64, systemd, postmarketOS)
# Fragmento base: se combina con la defconfig del árbol Linux mainline v7.1
# (base elegida en DECISION-0002). Solo se listan símbolos que deben existir;
# verify-kconfig.sh comprueba cada uno contra el Kconfig del commit fijado.

CONFIG_ARM64=y
CONFIG_LOCALVERSION="-postmarketos-sm6125"

# Filesystems de rootfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_STAT_FS=y

# UFS
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_UFS_QC_UFSHCD=y

# USB / DWC3 / gadget
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_ACM=y
CONFIG_USB_CONFIGFS_F_RNDIS=y
CONFIG_USB_CONFIGFS_F_NCM=y
CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGETFS=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_NCM=y

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y

# I2C / GENI
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y

# Touchscreen FT3518 (mainline: driver edt-ft5x06, compatible focaltech,ft3518)
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# DRM / MSM
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_PANEL_SAMSUNG_S6E8FC0=y

# IOMMU / SMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DMA=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# Interconnect / regulator / pinctrl / GPIO
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_QCOM_SMPS=y
CONFIG_GPIO_SYSFS=y
CONFIG_PINCTRL_QCOM=y
CONFIG_PINCTRL_SM6125=y

# Remoteproc / RPMSG / QRTR
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y

# Firmware loader
CONFIG_FW_LOADER=y

# CPUfreq / CPUidle
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_QCOM_CPUIDLE=y

# Thermal
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Power supply
CONFIG_POWER_SUPPLY=y
CONFIG_QCOM_BATT_METER=y
CONFIG_QCOM_SPMI_SCHG=y

# WLAN / BT Qualcomm
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_WCN36XX=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIBTUART=y
CONFIG_BT_HCIUART_QCOM=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_QCOMSMD=y

# GPU Adreno 610 (driver msm; el nodo DTS gpu@5900000 es parche downstream)
CONFIG_DRM_MSM_GPU_SUDO=y

# Proc
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
